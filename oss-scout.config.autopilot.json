{
  "$schema": "./schema/oss-scout.config.schema.json",
  "mode": "queue",
  "stateDir": "/workspaces/.oss-scout",
  "github": {
    "tokenEnv": "OSS_SCOUT_GITHUB_TOKEN",
    "writeTokenEnv": "OSS_SCOUT_WRITE_TOKEN"
  },
  "interests": {
    "languages": [
      "TypeScript",
      "JavaScript",
      "Python",
      "Java"
    ],
    "topics": [
      "react",
      "nextjs",
      "fastapi",
      "spring-boot",
      "mongodb",
      "llm",
      "security",
      "developer-tools"
    ],
    "keywords": []
  },
  "repos": {
    "allow": [
      "OWASP/OWASP-Hunting",
      "OWASP/wstg",
      "OWASP/owasp-mastg",
      "OWASP/Nest",
      "OWASP/Threat-Dragon",
      "OWASP/wrongsecrets",
      "OWASP/pytm",
      "DependencyTrack/dependency-track",
      "OpenRefine/OpenRefine",
      "freeCodeCamp/freeCodeCamp",
      "sugarlabs/musicblocks-v4",
      "layer5io/layer5",
      "apache/amoro",
      "apache/dolphinscheduler",
      "asyncapi/cli",
      "asyncapi/generator",
      "asyncapi/studio",
      "asyncapi/parser-js",
      "openwisp/openwisp-controller",
      "kornia/kornia",
      "xerial/sqlite-jdbc",
      "neomjs/neo",
      "soxoj/maigret",
      "R0Y00/Xbox2Windows",
      "aklivity/zilla",
      "ONEARMY/community-platform",
      "floci-io/floci",
      "jxxghp/MoviePilot",
      "career-ops-hq/career-ops"
    ],
    "deny": [
      "anthropics/claude-code",
      "MorpheApp/morphe-patches",
      "The-PR-Agent/pr-agent",
      "makecindy/cindy",
      "jenkinsci/jenkins",
      "rstudio/rstudio",
      "astropy/astropy",
      "wagtail/wagtail.org",
      "beeware/briefcase",
      "CircuitVerse/CircuitVerse",
      "processing/p5.js",
      "wemake-services/django-modern-rest",
      "learningequality/kolibri",
      "laurent22/joplin",
      "homarr-labs/homarr",
      "OpenCTI-Platform/opencti"
    ]
  },
  "screening": {
    "minStars": 100,
    "minScore": 0.55,
    "maxPerTick": 6
  },
  "caps": {
    "maxOpenPrsPerRepo": 1,
    "repoCooldownDays": 1,
    "maxSubmittedPrsPerWeek": 28,
    "maxPendingQueueItems": 10,
    "maxConcurrentTasks": 2
  },
  "implementation": {
    "model": null,
    "maxAttempts": 3,
    "maxDiffLines": 200
  },
  "critic": {
    "model": null,
    "minConfidence": 0.85
  },
  "sandbox": {
    "runtime": "docker",
    "memory": "4g",
    "cpus": "2"
  },
  "budget": {
    "perTask": {
      "maxTokens": 600000,
      "maxCostUsd": 5
    },
    "perDay": {
      "maxTokens": 10000000,
      "maxCostUsd": 70
    }
  },
  "disclosure": {
    "line": "Prepared with AI assistance; reviewed and tested by me."
  }
}
