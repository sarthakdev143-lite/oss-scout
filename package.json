{
  "name": "oss-scout",
  "version": "0.1.0",
  "description": "opencode plugin that finds, prepares and queues high-quality open source contributions for human review and approval",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "./server.ts",
  "bin": {
    "oss-scout": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run typecheck && bun test --timeout 30000",
    "cli": "bun src/cli.ts",
    "schema": "bun src/cli.ts config-schema > schema/oss-scout.config.schema.json"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.0",
    "@opencode/plugin": "2.0.24",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
